/*
Count hashing:
res - variable to put the hash output
use_ipv6 - use ipv6 or ipv4
seed - seed for the hash function, should be different for all
*/
#define get_hash(res, use_ipv6, seed) \
{ \
    if(use_ipv6){ \
        hash(res, HashAlgorithm.crc32, (bit<COUNT_BITS>)0, \
            {hdr.ipv6.srcAddr, hdr.ipv6.dstAddr, seed}, (bit<COUNT_BITS>)COUNT_WIDTH); \
    } else { \
        hash(res, HashAlgorithm.crc32, (bit<COUNT_BITS>)0, \
            {hdr.ipv4.srcAddr, hdr.ipv4.dstAddr, seed}, (bit<COUNT_BITS>)COUNT_WIDTH); \
    } \
}

/*
Count sign hashing:
res - variable to put the hash output
use_ipv6 - use ipv6 or ipv4
seed - seed for the hash function, should be different for all
*/
#define get_sign_hash(res, use_ipv6, seed) \
{ \
    if(use_ipv6){ \
        hash(res, HashAlgorithm.crc32, (bit<1>)0, {hdr.ipv6.srcAddr, hdr.ipv6.dstAddr, seed}, (bit<1>)2); \
    } else { \
        hash(res, HashAlgorithm.crc32, (bit<1>)0, {hdr.ipv4.srcAddr, hdr.ipv4.dstAddr, seed}, (bit<1>)2); \
    } \
}

